<script>

    function checkSuperClassStatus(courseId, classId) {
        $.ajax({
            type : "get",
            url : "/mooc2-ans/visit/checksuperclassstatus",
            data : {
                courseId : courseId,
                clazzId : classId
            },
            dataType : "json",
            success : function(data){
                if(data.status){
                    location.href = "ChaoxingClassroomPc://open_type=openMeeting&courseId=" + courseId + "&classId=" + classId + "&browser_uid=" + userId + "&ut=s";
                }else{
                    alert("该班级暂无在线课堂。");
                }
            }
        })

    }
</script>
